<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Chat</title>
</head>
<body>
    <form method="post" action="/chats/newchat">

        <input type="text" name="from" placeholder="Sending by">
        <br><br>
        <textarea name="msg"  >Enter message </textarea>
        <br><br>
        <input type="text" name="to" placeholder="Sending to">
        <button type="submit">Send</button>
    </form>
</body>
</html>